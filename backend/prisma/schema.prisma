generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
}

enum CommentStatus {
  OPEN
  RESOLVED
}

enum CommentReplyAuthorType {
  DEVELOPER
  CLIENT
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  passwordHash String
  firstName    String?
  lastName     String?

  memberships     OrganizationMember[]
  projectsCreated Project[]            @relation("ProjectCreatedBy")
  commentReplies  CommentReply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Organization {
  id   String @id @default(uuid())
  name String

  members  OrganizationMember[]
  projects Project[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OrganizationMember {
  id String @id @default(uuid())

  organizationId String
  userId         String

  role OrganizationRole @default(MEMBER)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([organizationId, userId])
}

model Project {
  id String @id @default(uuid())

  organizationId String
  createdById    String

  name String

  publicKey      String   @unique @default(cuid())
  allowedDomains String[] @default([])

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("ProjectCreatedBy", fields: [createdById], references: [id])

  reviewRounds ReviewRound[]
  tasks        Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ReviewRoundStatus {
  DRAFT
  REVIEWING
  APPROVED
  CLOSED
}

model ReviewRound {
  id String @id @default(uuid())

  projectId String

  name      String
  targetUrl String
  version   Int

  status ReviewRoundStatus @default(DRAFT)

  sdkLastSeenAt DateTime?
  sdkLastOrigin String?

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewLinks ReviewLink[]
  comments    Comment[]
  tasks       Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, version])
  @@index([projectId])
}

model ReviewLink {
  id String @id @default(uuid())

  reviewRoundId String

  tokenHash String @unique

  isActive  Boolean   @default(true)
  expiresAt DateTime?
  comments  Comment[]

  replies CommentReply[]

  reviewRound ReviewRound @relation(fields: [reviewRoundId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewRoundId])
}

model Comment {
  id String @id @default(uuid())

  reviewRoundId String
  reviewLinkId  String?

  comment String

  pathname        String
  tagName         String
  reviewElementId String?
  elementId       String?
  elementText     String?

  viewportWidth  Int
  viewportHeight Int

  elementX      Float
  elementY      Float
  elementWidth  Float
  elementHeight Float

  status CommentStatus @default(OPEN)

  reviewRound ReviewRound @relation(fields: [reviewRoundId], references: [id], onDelete: Cascade)
  reviewLink  ReviewLink? @relation(fields: [reviewLinkId], references: [id], onDelete: SetNull)
  replies     CommentReply[]
  task        Task?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reviewRoundId])
  @@index([reviewLinkId])
}

model CommentReply {
  id           String                 @id @default(uuid())
  commentId    String
  authorType   CommentReplyAuthorType
  authorName   String                 @db.VarChar(160)
  authorId     String?
  reviewLinkId String?
  message      String                 @db.VarChar(5000)
  createdAt    DateTime               @default(now())

  comment    Comment     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  author     User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  reviewLink ReviewLink? @relation(fields: [reviewLinkId], references: [id], onDelete: SetNull)

  @@index([commentId, createdAt, id])
  @@index([authorId])
  @@index([reviewLinkId])
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  ON_HOLD
  DONE
}

model Task {
  id             String      @id @default(uuid())
  organizationId String?
  projectId      String
  reviewRoundId  String
  commentId      String      @unique

  title          String
  description    String?

  status         TaskStatus  @default(TODO)
  position       Float       @default(0)

  comment     Comment     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reviewRound ReviewRound @relation(fields: [reviewRoundId], references: [id], onDelete: Cascade)
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([reviewRoundId, status])
  @@index([projectId])
}
